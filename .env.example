# Copy this file to .env and edit it. The repository also ships a local .env
# with these safe defaults so `docker compose up -d` works immediately.

# Docker / paths
COMPOSE_PROJECT_NAME=cs2ze
CONTAINER_NAME=cs2ze-server
CS2_IMAGE=joedwards32/cs2:latest
CS2_DATA_PATH=./cs2-data
STOP_GRACE_PERIOD=30s

# Panel. Set DOCKER_GID to the host docker group's gid (`getent group docker`).
DOCKER_GID=983
PANEL_DATA_PATH=./panel-data
PANEL_PUBLISHED_PORT=8090
# Empty publishes on all interfaces. Use 127.0.0.1 to bind locally.
PANEL_BIND_ADDR=
PANEL_COOKIE_SECURE=0
PANEL_TRUST_PROXY=0
# Optional bootstrap credentials. If blank, the panel generates an admin password
# and prints it once in `docker compose logs cs2-panel`.
PANEL_ADMIN_USER=
PANEL_ADMIN_PASSWORD=

# Published host ports
CS2_PUBLISHED_PORT=27015
CS2_RCON_PUBLISHED_PORT=27050
TV_PUBLISHED_PORT=27020

# Required for an Internet server. Create one for app 730 at:
# https://steamcommunity.com/dev/managegameservers
SRCDS_TOKEN=

# joedwards32/cs2 server settings
CS2_SERVERNAME=CS2 Zombie Escape
CS2_CHEATS=0
CS2_SERVER_HIBERNATE=0
CS2_SERVER_DELTATICKS_ENFORCE=2
CS2_IP=0.0.0.0
CS2_PORT=27015
CS2_RCON_PORT=27050
CS2_LAN=0
# Required. Generate a strong unique value before starting the server.
CS2_RCONPW=
CS2_PW=
CS2_MAXPLAYERS=32
# Required for CS2Fixes to intercept host_workshop_collection at startup.
CS2_ADDITIONAL_ARGS=-disable_workshop_command_filtering
CS2_CFG_URL=
CS2_GAMEALIAS=casual
CS2_GAMETYPE=0
CS2_GAMEMODE=0
CS2_MAPGROUP=mg_active
CS2_STARTMAP=de_dust2
# CS2Fixes intercepts this startup command and replaces the collection with
# server-config/cs2fixes/maplist.jsonc. Keep it non-empty for nominations/map votes.
# This small bootstrap collection is only used to trigger that hook.
CS2_HOST_WORKSHOP_COLLECTION=3222748625
# Working example from the GFL Zombie Escape workshop collection:
# https://steamcommunity.com/sharedfiles/filedetails/?id=3144617784
CS2_HOST_WORKSHOP_MAP=3144617784
CS2_BOT_DIFFICULTY=
CS2_BOT_QUOTA=0
CS2_BOT_QUOTA_MODE=fill
DEBUG=0
STEAMAPPVALIDATE=0

# CSTV
TV_ENABLE=0
TV_PORT=27020
TV_AUTORECORD=0
TV_PW=
TV_RELAY_PW=
TV_MAXRATE=0
TV_DELAY=0
TV_RELAYVOICE=1

# Logging
CS2_LOG=on
CS2_LOG_FILE=1
CS2_LOG_ECHO=0
CS2_LOG_MONEY=0
CS2_LOG_DETAIL=0
CS2_LOG_ITEMS=0
CS2_DISCONNECT_KILLS=1
CS2_LOG_HTTP_URL=

# Compatible mod release set. Do not independently upgrade Metamod past build
# 1411 with these defaults; see README.md for the current upstream split.
INSTALL_METAMOD=1
METAMOD_VERSION=2.0.0-git1411
METAMOD_URL=

INSTALL_CS2FIXES=1
CS2FIXES_VERSION=v1.20.1
CS2FIXES_RUNTIME=steamrt3
CS2FIXES_URL=

# ZombieReborn is included in CS2Fixes.
ZR_ENABLE=1
CS2FIXES_COMMANDS_ENABLE=1
CS2FIXES_ADMIN_COMMANDS_ENABLE=1
CS2FIXES_WEAPONS_ENABLE=1
CS2FIXES_STOPSOUND_ENABLE=1
CS2FIXES_NOBLOCK_ENABLE=1
CS2FIXES_NOBLOCK_GRENADES=1
CS2FIXES_BLOCK_TEAM_MESSAGES=1
CS2FIXES_MOVEMENT_UNLOCKER_ENABLE=1
CS2FIXES_USE_OLD_PUSH=1
CS2FIXES_HIDE_ENABLE=1
CS2FIXES_TRIGGER_TIMER_ENABLE=1
CS2FIXES_CVARWHITELIST_ENABLE=1
CS2FIXES_VOTEMANAGER_ENABLE=1
CS2FIXES_BLOCK_NAV_LOOKUP=1
CS2FIXES_FLASHLIGHT_ENABLE=1
CS2FIXES_FLASHLIGHT_SHADOWS=0
CS2FIXES_FLASHLIGHT_TRANSMIT_OTHERS=1
CS2FIXES_INFINITE_RESERVE_AMMO=1
CS2FIXES_FULL_ALLTALK=1
CS2FIXES_PREVENT_USING_PLAYERS=1
CS2FIXES_FIX_GAME_BANS=1
CS2FIXES_FREE_ARMOR=2
CS2FIXES_NOSHAKE_ENABLE=1
CS2FIXES_BLOCK_MOLOTOV_SELF_DMG=1
CS2FIXES_FIX_BLOCK_DMG=1
CS2FIXES_TOPDEFENDER_ENABLE=1

# Zombie Escape gameplay and map voting
ZR_KNOCKBACK_SCALE=5.0
# One player makes first-boot testing work; increase this on a busy public server.
ZR_INFECT_MIN_COUNT_REQ=1
ZR_RESPAWN_DELAY=5.0
CS2FIXES_RTV_VOTE_DELAY=60
CS2FIXES_RTV_SUCCESS_RATIO=0.60
CS2FIXES_EXTENDS=1
CS2FIXES_EXTEND_TIME=20

# Round/map rules written to cfg/cs2fixes/server.cfg and into the game's
# gamemode_*.cfg files (warmup is disabled there unconditionally)
ZE_MAP_TIME_LIMIT=40
ZE_ROUND_TIME=60
ZE_FREEZE_TIME=5
# 0 disables fall damage; 1 restores the normal CS2 damage scale.
ZE_FALL_DAMAGE_SCALE=0
ZE_BUY_TIME=9999999
ZE_BUY_ANYWHERE=1
ZE_WEAPON_BUY_LIMIT=-1
ZE_GRENADE_BUY_LIMIT=2
# Money every player is given at the start of each round.
ZE_ROUND_MONEY=16000

# Optional owner admin. Use a 17-digit SteamID64; blank means no generated admin.
CS2_ADMIN_STEAMID=
CS2_ADMIN_NAME=Server Owner
CS2_ADMIN_FLAGS=z
# Extra entries separated by semicolons, for example:
# CS2FIXES_EXTRA_CFG=cs2f_flashlight_enable 1;zr_knockback_scale 5.0
CS2FIXES_EXTRA_CFG=

INSTALL_MULTIADDONMANAGER=1
MULTIADDONMANAGER_VERSION=v1.5.4
MULTIADDONMANAGER_RUNTIME=steamrt3
MULTIADDONMANAGER_URL=
# GFL Zombie Escape Content: required map content, mounted server side and
# required from clients. https://steamcommunity.com/sharedfiles/filedetails/?id=3160448201
MAM_EXTRA_ADDONS=3160448201
MAM_CLIENT_EXTRA_ADDONS=
MAM_EXTRA_ADDONS_TIMEOUT=10
MAM_ADDON_CONNECTION_TIMEOUT=30
MAM_ADDON_MOUNT_DOWNLOAD=0
MAM_CACHE_CLIENTS_WITH_ADDONS=0
MAM_CACHE_CLIENTS_DURATION=0
MAM_BLOCK_DISCONNECT_MESSAGES=0
MAM_ADDON_DEBUG=0

INSTALL_STRIPPERCS2=1
STRIPPERCS2_VERSION=v1.1.3
# Optional direct URL to a compiled release archive. Leave blank to download the
# version above automatically; the GitHub repository page itself is not an archive.
# Example: https://github.com/Source2ZE/StripperCS2/releases/download/v1.1.3/StripperCS2-1.1.3.zip
STRIPPERCS2_URL=

# Set to 1 for one start when you want all enabled archives downloaded again.
MODS_FORCE_REINSTALL=0
